{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/pages/**/*.{ts,tsx}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.ts",
    "index.html"
  ],
  "ignoreFindings": [
    "src/components/**",
    "src/services/**",
    "src/constants/**",
    "src/types/**",
    "src/utils/**"
  ],
  "ignoreDependencies": ["zod", "zustand", "tailwind-merge", "lint-staged"],
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
