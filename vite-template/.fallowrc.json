{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/pages/**/*.{ts,tsx}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.ts",
    "index.html"
  ],
  "ignoreFindings": [
    "src/components/example/**",
    "src/components/ui/**",
    "src/features/example/**",
    "src/fetchers/example/**",
    "src/hooks/example/**",
    "src/lib/utils.ts",
    "src/constants/example.ts",
    "src/types/example.ts",
    "src/utils/example/**"
  ],
  "ignoreDependencies": ["zod", "zustand", "tailwind-merge", "lint-staged"],
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
