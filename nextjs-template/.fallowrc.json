{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "ignoreFindings": [
    "src/components/example/**",
    "src/services/example-api/**",
    "src/constants/example.ts",
    "src/types/example.ts",
    "src/utils/example/**"
  ],
  "ignoreDependencies": [
    "@vitejs/plugin-react",
    "zod",
    "zustand",
    "tailwind-merge",
    "lint-staged"
  ],
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
