{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,default}.{ts,tsx}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "ignoreFindings": [
    "src/components/**",
    "src/services/**",
    "src/constants/**",
    "src/types/**",
    "src/utils/**"
  ],
  "ignoreDependencies": [
    "@vitejs/plugin-react",
    "zod",
    "zustand",
    "tailwind-merge",
    "lint-staged"
  ],
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
